{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^db:generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts",
        "package.json"
      ],
      "outputs": [
        "src/infrastructure/persistence/prisma/generated/**"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ],
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL"
      ]
    }
  }
}
