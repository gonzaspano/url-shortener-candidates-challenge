# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (docker compose up -d db)
DATABASE_URL=postgresql://url_shortener:url_shortener@localhost:5432/url_shortener
TEST_DATABASE_URL=postgresql://url_shortener:url_shortener@localhost:5432/url_shortener_test
